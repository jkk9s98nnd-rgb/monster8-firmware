<Window
    x:Class="UniversalVideoPlayerPro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Universal Video Player Pro">

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="104" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,9" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <TextBlock Text="▶" Foreground="White" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Universal Video Player Pro" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="FileNameText" Text="Ready" FontSize="11" Opacity="0.65"
                                   MaxWidth="720" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="HEVC" Click="HevcButton_Click" ToolTipService.ToolTip="Check HEVC support" />
                    <Button Content="Open video" Click="OpenButton_Click" Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#050505">
            <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="False" AutoPlay="False" Stretch="Uniform" />

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="▶" FontSize="58" HorizontalAlignment="Center" Foreground="White" Opacity="0.9" />
                <TextBlock Text="Open or drop a video here" FontSize="22" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="MP4 • MKV • MOV • AVI • WMV • WebM • MTS • M2TS • MPEG and more"
                           FontSize="12" Foreground="White" Opacity="0.58" HorizontalAlignment="Center" />
                <Button Content="Choose a video" Click="OpenButton_Click" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True"
                     HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16" />
        </Grid>

        <Border Grid.Row="2" Padding="16,8,16,12" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid RowSpacing="7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Text="00:00" FontSize="12" VerticalAlignment="Center" />
                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0"
                            StepFrequency="0.1" ValueChanged="SeekSlider_ValueChanged" />
                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00" FontSize="12" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="−10" Width="48" Click="Back10Button_Click" />
                    <Button Grid.Column="1" x:Name="PlayPauseButton" Content="▶" Width="48" FontSize="18" Click="PlayPauseButton_Click" />
                    <Button Grid.Column="2" Content="+10" Width="48" Click="Forward10Button_Click" />
                    <Button Grid.Column="3" Content="■" Width="42" Click="StopButton_Click" />

                    <TextBlock Grid.Column="5" Text="Volume" VerticalAlignment="Center" FontSize="12" Opacity="0.75" />
                    <Slider x:Name="VolumeSlider" Grid.Column="6" Minimum="0" Maximum="100" Value="80"
                            ValueChanged="VolumeSlider_ValueChanged" />

                    <ComboBox x:Name="SpeedComboBox" Grid.Column="8" Width="86" SelectedIndex="3"
                              SelectionChanged="SpeedComboBox_SelectionChanged">
                        <ComboBoxItem Content="0.5×" Tag="0.5" />
                        <ComboBoxItem Content="0.75×" Tag="0.75" />
                        <ComboBoxItem Content="0.9×" Tag="0.9" />
                        <ComboBoxItem Content="1.0×" Tag="1.0" />
                        <ComboBoxItem Content="1.25×" Tag="1.25" />
                        <ComboBoxItem Content="1.5×" Tag="1.5" />
                        <ComboBoxItem Content="2.0×" Tag="2.0" />
                    </ComboBox>

                    <Button Grid.Column="9" Content="Subtitles" Click="SubtitleButton_Click" />
                    <Button Grid.Column="11" x:Name="FullScreenButton" Content="Full screen" Click="FullScreenButton_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
