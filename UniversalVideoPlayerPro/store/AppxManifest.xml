<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">

  <Identity
    Name="MarksVisualSoftware.UniversalVideoPlayerPro"
    Publisher="CN=126DA3AD-19F4-4631-B731-38897D05C7B0"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Universal Video Player Pro</DisplayName>
    <PublisherDisplayName>Mark's Visual Software</PublisherDisplayName>
    <Description>A modern, customizable Windows video player with broad format support and HEVC guidance.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application
      Id="App"
      Executable="UniversalVideoPlayerPro.exe"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">

      <uap:VisualElements
        DisplayName="Universal Video Player Pro"
        Description="Modern video playback with customizable skins and HEVC support guidance."
        BackgroundColor="#0B1020"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="universalvideoplayerpro.video">
            <uap:DisplayName>Universal Video Player Pro Video</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.mp4</uap:FileType>
              <uap:FileType>.m4v</uap:FileType>
              <uap:FileType>.mkv</uap:FileType>
              <uap:FileType>.mov</uap:FileType>
              <uap:FileType>.avi</uap:FileType>
              <uap:FileType>.wmv</uap:FileType>
              <uap:FileType>.webm</uap:FileType>
              <uap:FileType>.mpg</uap:FileType>
              <uap:FileType>.mpeg</uap:FileType>
              <uap:FileType>.mpe</uap:FileType>
              <uap:FileType>.mts</uap:FileType>
              <uap:FileType>.m2ts</uap:FileType>
              <uap:FileType>.ts</uap:FileType>
              <uap:FileType>.3gp</uap:FileType>
              <uap:FileType>.3g2</uap:FileType>
              <uap:FileType>.asf</uap:FileType>
              <uap:FileType>.hevc</uap:FileType>
              <uap:FileType>.h265</uap:FileType>
              <uap:FileType>.265</uap:FileType>
              <uap:FileType>.m2v</uap:FileType>
              <uap:FileType>.vob</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
